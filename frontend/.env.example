# Optional: public HTTPS base for QR share links (tunnel / domain)
# VITE_PUBLIC_URL=https://your-tunnel.example

# Required for Capacitor APK builds that call a remote backend
# (leave empty for browser/PWA when Express serves frontend/dist)
# VITE_API_BASE=https://your-server.example
# or LAN: VITE_API_BASE=http://192.168.1.10:5000
